# ─── Banco ─────────────────────────────────────────────────────────────────
# Postgres do compose (perfil offline):
DATABASE_URL=postgresql+asyncpg://cpa:cpa@banco:5432/cpa
# Supabase (produção) — troque pela string do painel do projeto:
# DATABASE_URL=postgresql+asyncpg://postgres:SENHA@db.xxxx.supabase.co:5432/postgres

# ─── Painel administrativo ─────────────────────────────────────────────────
ADMIN_USER=cpa
# Mínimo 16 caracteres. NUNCA versione o .env preenchido.
ADMIN_PASSWORD=

# ─── Aplicação ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
TIMEZONE=America/Sao_Paulo

# ─── Regras de exibição (doc 08 §4) ────────────────────────────────────────
# Limiar de k-anonimato para discentes:
MIN_RESPOSTAS_EXIBICAO=5
# Limiar para técnico-administrativo e comunidade (universo pequeno):
MIN_RESPOSTAS_EXIBICAO_RESTRITO=10
# Avisa na geração se o formulário passar deste tamanho:
LIMITE_ALERTA_PERGUNTAS=150
# Faixas de cor do ISG, herdadas do painel 2024:
ISG_FAIXAS=0.25,0.46,0.72

# ─── Importação da grade ───────────────────────────────────────────────────
MAX_UPLOAD_MB=5

# ─── Google Forms (doc 10 §4) — necessários a partir da Fase 5 ─────────────
# ⚠️ Publique o app como "In production" (ou "Internal") no Google Cloud ANTES
# de gerar o refresh token: apps em "Testing" emitem token que expira em 7 dias.
# Gere o refresh token com: python -m scripts.autorizar_google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ─── Frontend ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
# true = painel roda com dados de exemplo, sem backend (Fase 1)
VITE_USE_MOCK=true
