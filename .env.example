# ─── Banco ─────────────────────────────────────────────────────────────────
# Postgres do compose (perfil offline):
DATABASE_URL=postgresql+asyncpg://cpa:cpa@banco:5432/cpa
# Supabase (produção) — troque pela string do painel do projeto:
# DATABASE_URL=postgresql+asyncpg://postgres:SENHA@db.xxxx.supabase.co:5432/postgres

# ─── Painel administrativo ─────────────────────────────────────────────────
ADMIN_USER=cpa
# Mínimo 16 caracteres. NUNCA versione o .env preenchido.
ADMIN_PASSWORD=

# ─── Aplicação ─────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
TIMEZONE=America/Sao_Paulo

# ─── Regras de exibição (doc 08 §4) ────────────────────────────────────────
# Limiar de k-anonimato para discentes:
MIN_RESPOSTAS_EXIBICAO=5
# Limiar para técnico-administrativo e comunidade (universo pequeno):
MIN_RESPOSTAS_EXIBICAO_RESTRITO=10
# Avisa na geração se o formulário passar deste tamanho:
LIMITE_ALERTA_PERGUNTAS=150
# Faixas de cor do ISG, herdadas do painel 2024:
ISG_FAIXAS=0.25,0.46,0.72

# ─── Importação da grade ───────────────────────────────────────────────────
MAX_UPLOAD_MB=5

# ─── Google Forms (doc 10 §4) — necessários a partir da Fase 5 ─────────────
# Roteiro completo: .agent/02-especificacao/anexos/C_configurar_google_cloud.md
#
# ⚠️ `forms.body` é escopo SENSÍVEL para o Google. Se o projeto no Cloud Console
#    for do tipo "Externo" e estiver em "Testing", o refresh token expira em
#    7 DIAS. Publicá-lo exige verificação do Google (semanas). Se a FPM tiver
#    Google Workspace, crie o projeto como "Interno" — nada disso se aplica.
#
# Gere as três primeiras com:  python -m scripts.autorizar_google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ─── Frontend ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
# true = painel roda com dados de exemplo, sem backend. Serve para demonstrar
# o fluxo à CPA sem subir nada. Mantenha false: em true o painel mostra números
# plausíveis que NÃO vêm do banco, e a faixa amarela no topo é o único aviso.
# Vite resolve isto no build — mudar exige `docker compose up -d --build frontend`.
VITE_USE_MOCK=false
